# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# All three come from: LaunchDarkly > your project > Project settings >
# Environments > Test. They are NOT interchangeable.

# SERVER SDK key for the .NET service. SECRET - stays in the container env,
# never in an image, never in a client.
LD_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# CLIENT-SIDE ID for the Flutter app built for web. Public by design - it is
# compiled into the web bundle and served to every browser.
LD_CLIENT_SIDE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# MOBILE key - only needed if you build the Flutter app for iOS/Android rather
# than web. Also public by design. Left unset for the containerised web demo.
#LD_MOBILE_KEY=mob-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API token used only by scripts/provision.py to create the project, flags,
# segment and metrics. A Writer token is enough. Not needed to run the demo.
#LD_API_TOKEN=api-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
