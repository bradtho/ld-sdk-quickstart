<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LdQuickstart.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server-side SDK. Takes a *server* SDK key (sdk-...).
         Package name and namespace differ: package LaunchDarkly.ServerSdk,
         namespaces LaunchDarkly.Sdk and LaunchDarkly.Sdk.Server. -->
    <PackageReference Include="LaunchDarkly.ServerSdk" Version="8.17.2" />
  </ItemGroup>

</Project>
